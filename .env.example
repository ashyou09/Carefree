# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=skinplan

# Long random string used to sign the login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# First account created automatically on first run (password is stored hashed).
SEED_USERNAME=manorama
SEED_NAME=Manorama
SEED_PASSWORD=12345678

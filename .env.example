# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=skinplan

# Optional. Key that signs the login cookie. If not set, one is generated
# automatically and stored in the database (collection "config").
# AUTH_SECRET=

# Optional. First account created automatically on first run (password stored hashed).
# Defaults: manorama / Manorama / 12345678
SEED_USERNAME=manorama
SEED_NAME=Manorama
SEED_PASSWORD=12345678
